# -----------------------------------------------------------------------------
# .env.example — copy to .env for local scripts / integration tests.
#
# .env is gitignored. Do NOT put real hosted-project keys in a committed file.
# Hosted secrets go through `supabase secrets set` for functions, and stay in
# the local shell (or a password manager) for scripts.
# -----------------------------------------------------------------------------

# --- Injected by the Edge Functions platform ---------------------------------
# The functions read these via Deno.env.get() at runtime. The Supabase CLI
# sets them automatically when running functions locally OR when the function
# runs on the hosted project. You only need to export them yourself if you
# run a function outside `supabase start` / `supabase functions serve`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace-with-value-from-supabase-status

# --- Integration tests (supabase/functions/_tests/integration/) --------------
# INTEGRATION gates the whole folder — leave unset for the fast unit path.
# The two keys are printed by `supabase status`; the integration helper uses
# ANON_KEY for the apikey header and SERVICE_ROLE_KEY as an admin fallback.
INTEGRATION=1
SUPABASE_ANON_KEY=replace-with-value-from-supabase-status

# --- Deploy scripts ----------------------------------------------------------
# scripts/deploy.sh links + pushes migrations + deploys every function to the
# hosted project identified by this ref. Grab it from your project dashboard
# URL. Never commit a real ref alongside real keys.
PROJECT_REF=your-project-ref-here

# scripts/seed-remote.sh takes the pooler connection string from
# Project Settings → Database on the hosted dashboard. Contains the DB
# password — DO NOT COMMIT.
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# Older Supabase CLI versions ignore `verify_jwt = false` in config.toml on
# deploy, which leaves public endpoints returning 401. Set NO_VERIFY_JWT=1
# when running scripts/deploy.sh to append `--no-verify-jwt` to the deploy
# calls as a workaround. Leave unset on newer CLIs — the config is honoured.
# NO_VERIFY_JWT=1
