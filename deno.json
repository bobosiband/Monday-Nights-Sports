{
  "tasks": {
    "test": "deno test --allow-net --allow-env --ignore=tests/integration/ tests/",
    "test:integration": "INTEGRATION=1 deno test --allow-net --allow-env tests/integration/",
    "check": "bash -c 'for f in supabase/functions/*/index.ts; do echo \"checking $f\"; deno check \"$f\" || exit 1; done'",
    "fmt": "deno fmt",
    "lint": "deno lint"
  },
  "fmt": {
    "lineWidth": 80,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "exclude": [
      "supabase/functions/api-docs/openapi.ts",
      "docs/openapi.yaml",
      "docs/archive/"
    ]
  },
  "lint": {
    "exclude": [
      "supabase/functions/api-docs/openapi.ts"
    ],
    "rules": {
      "exclude": [
        "no-import-prefix"
      ]
    }
  }
}
